{
  "name": "dsh-proactive-questioning",
  "version": "0.1.3",
  "private": true,
  "description": "Private DSH non-blocking, per-conversation user-question bubbles.",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "src",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test": "node --test ./tests/*.test.mjs",
    "check": "node --check ./src/protocol.mjs && node --check ./src/client/lifecycle.mjs && npm run test && npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}

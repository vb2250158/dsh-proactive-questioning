{
  "name": "dsh-proactive-questioning",
  "version": "0.1.8",
  "private": true,
  "description": "Private DSH non-blocking, per-conversation user-question bubbles.",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "src",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test": "node --test ./tests/*.test.mjs",
    "test:render": "node ./tests/render-smoke.mjs",
    "test:visual": "node ./tests/visual-preview.mjs",
    "check": "node --check ./src/protocol.mjs && node --check ./src/client/lifecycle.mjs && npm run test && npm run build"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1 <5.0.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-alpha.1 <0.3.0",
    "react": "^18.2.0",
    "@deepseek-ai/schemastery": ">=3.18.5-alpha.1 <4.0.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.1-alpha.1 <0.3.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
